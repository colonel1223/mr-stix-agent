# ═══════════════════════════════════════════════════
# MR. STIX AGENT — CONFIGURATION
# ═══════════════════════════════════════════════════
# He doesn't need much. But what he needs, he needs.

# Core AI Provider
ANTHROPIC_API_KEY=your-api-key-here
STIX_MODEL=claude-sonnet-4-20250514

# Agent Behavior
STIX_MAX_ITERATIONS=50
STIX_TIMEOUT_MS=120000
STIX_VERBOSE=true
STIX_PERSONALITY=smug

# Server
STIX_PORT=3117
STIX_WS_PORT=3118

# Tool Permissions (enable what Mr. Stix can touch)
STIX_TOOL_FILESYSTEM=true
STIX_TOOL_BROWSER=true
STIX_TOOL_SHELL=true
STIX_TOOL_DATABASE=true
STIX_TOOL_EMAIL=false
STIX_TOOL_CALENDAR=false
STIX_TOOL_SLACK=false

# Safety Rails (he respects boundaries... mostly)
STIX_CONFIRM_DESTRUCTIVE=true
STIX_SANDBOX_MODE=true
STIX_LOG_ALL_ACTIONS=true
STIX_WORKING_DIR=./workspace
